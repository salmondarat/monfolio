---
// HeroDesignCanvas.astro — Abstract Graphic Craft Atmosphere
// Deconstructed visual craft: Golden ratio arcs, undulating vector Béziers, typographic geometry & ambient light
---

<div class="hero-design-canvas" aria-hidden="true">
  <!-- Atmospheric Studio Ambient Glow -->
  <div class="canvas-ambient">
    <div class="ambient-orb orb-primary"></div>
    <div class="ambient-orb orb-secondary"></div>
    <div class="ambient-orb orb-tertiary"></div>
  </div>

  <!-- Abstract Graphic Geometry SVG Stage -->
  <div class="canvas-svg-stage">
    <svg class="canvas-svg" viewBox="0 0 1400 800" fill="none" preserveAspectRatio="xMidYMid slice">
      <defs>
        <!-- Subtle accent gradient for flowing vector curves -->
        <linearGradient id="craft-accent-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.1" />
          <stop offset="45%" stop-color="var(--color-accent)" stop-opacity="0.8" />
          <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0.15" />
        </linearGradient>

        <linearGradient id="craft-secondary-grad" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.1" />
          <stop offset="50%" stop-color="var(--color-accent)" stop-opacity="0.5" />
          <stop offset="100%" stop-color="#818cf8" stop-opacity="0.1" />
        </linearGradient>
      </defs>

      <!-- 1. Abstract Baseline & Horizon Metrics (Typographic Guide Metaphor) -->
      <g class="abstract-baselines">
        <line x1="60" y1="190" x2="1340" y2="190" class="guide-line guide-cap" />
        <line x1="120" y1="280" x2="1280" y2="280" class="guide-line guide-mean" />
        <line x1="40" y1="420" x2="1360" y2="420" class="guide-line guide-base" />
        <line x1="160" y1="500" x2="1240" y2="500" class="guide-line guide-desc" />
        
        <!-- Subtle architectural tick marks -->
        <g class="guide-ticks">
          <line x1="240" y1="184" x2="240" y2="196" class="tick-mark" />
          <line x1="520" y1="184" x2="520" y2="196" class="tick-mark" />
          <line x1="880" y1="184" x2="880" y2="196" class="tick-mark" />
          <line x1="1160" y1="184" x2="1160" y2="196" class="tick-mark" />
          <circle cx="520" cy="420" r="3" class="tick-circle" />
          <circle cx="880" cy="420" r="3" class="tick-circle" />
        </g>
      </g>

      <!-- 2. Deconstructed Golden Ratio (Harmonic Concentric Arcs & Fibonacci Spiral) -->
      <g class="golden-abstract" transform="translate(740, 120)">
        <!-- Rotating Geometric Concentric Circles (Proportions: 233, 144, 89) -->
        <g class="golden-spin-group">
          <circle cx="200" cy="200" r="233" class="phi-ring phi-outer" />
          <circle cx="200" cy="200" r="144" class="phi-ring phi-mid" />
          <circle cx="200" cy="200" r="89" class="phi-ring phi-inner" />
          
          <!-- Golden Section axis crosshairs -->
          <line x1="-30" y1="200" x2="430" y2="200" class="phi-axis" />
          <line x1="200" y1="-30" x2="200" y2="430" class="phi-axis" />
          <line x1="45" y1="45" x2="355" y2="355" class="phi-diagonal" />

          <!-- Delicate node markers along the golden ratio axes -->
          <circle cx="344" cy="200" r="2.5" class="phi-node" />
          <circle cx="200" cy="56" r="2.5" class="phi-node" />
          <circle cx="89" cy="200" r="2.5" class="phi-node" />
        </g>

        <!-- Dynamic Ethereal Fibonacci Spiral Curve -->
        <path class="fibonacci-spiral"
              d="M 56,344 A 288 288 0 0 1 344 56 A 178 178 0 0 1 522 234 A 110 110 0 0 1 412 344 A 68 68 0 0 1 344 276 A 42 42 0 0 1 386 234" 
              fill="none" />
      </g>

      <!-- 3. Fluid Abstract Bézier Vector Waves & Tangent Nodes -->
      <g class="bezier-abstract">
        <!-- Master Vector Curve (Flowing through hero space) -->
        <path class="bezier-wave wave-primary" 
              d="M 30,560 C 300,640 360,190 700,240 S 1060,460 1380,230" 
              fill="none" stroke="url(#craft-accent-grad)" />
        
        <!-- Ghost Echo Curve -->
        <path class="bezier-wave wave-ghost" 
              d="M 30,560 C 300,640 360,190 700,240 S 1060,460 1380,230" 
              fill="none" />

        <!-- Counter-balancing secondary flow line -->
        <path class="bezier-wave wave-secondary" 
              d="M 60,490 C 340,390 440,600 840,430 S 1180,170 1370,380" 
              fill="none" stroke="url(#craft-secondary-grad)" />

        <!-- Abstract Tangent Handle & Anchor System (Floating softly) -->
        <g class="tangent-system tangent-node-primary" transform="translate(700, 240)">
          <!-- Tangent Vector Stick -->
          <line x1="-120" y1="-26" x2="120" y2="26" class="tangent-rod" />
          <!-- Directional Handle Nodes -->
          <circle cx="-120" cy="-26" r="3.5" class="tangent-handle" />
          <circle cx="120" cy="26" r="3.5" class="tangent-handle" />
          <!-- Center Vector Anchor Point -->
          <rect x="-4.5" y="-4.5" width="9" height="9" class="anchor-square" rx="1" />
          <!-- Pulse Aura -->
          <circle cx="0" cy="0" r="14" class="anchor-aura" />
        </g>

        <!-- Secondary Vector Anchor (Left) -->
        <g class="tangent-system tangent-node-secondary" transform="translate(360, 290)">
          <line x1="-75" y1="40" x2="75" y2="-40" class="tangent-rod-faint" />
          <circle cx="-75" cy="40" r="2.5" class="tangent-handle-faint" />
          <circle cx="75" cy="-40" r="2.5" class="tangent-handle-faint" />
          <rect x="-3" y="-3" width="6" height="6" class="anchor-square-faint" rx="1" />
        </g>
      </g>

      <!-- 4. Abstract Letterform Optical Geometry (Concentric arcs & Apex) -->
      <g class="letterform-abstract" transform="translate(180, 260)">
        <!-- Optical construction circles of geometric sans letterforms -->
        <circle cx="120" cy="140" r="95" class="optical-circle circle-left" />
        <circle cx="210" cy="140" r="95" class="optical-circle circle-right" />
        
        <!-- Deconstructed geometric letterform outline (Abstract 'M' / Chevron Apex) -->
        <path d="M 30,240 L 120,60 L 210,180 L 300,60 L 390,240" class="optical-path" />

        <!-- Minimalist crosshair precision markers -->
        <g transform="translate(120, 60)" class="crosshair">
          <line x1="-7" y1="0" x2="7" y2="0" />
          <line x1="0" y1="-7" x2="0" y2="7" />
        </g>
        <g transform="translate(300, 60)" class="crosshair">
          <line x1="-7" y1="0" x2="7" y2="0" />
          <line x1="0" y1="-7" x2="0" y2="7" />
        </g>
      </g>
    </svg>
  </div>

  <!-- Layer 5: Architectural Grid with Soft Vignette -->
  <div class="canvas-grid-overlay"></div>
</div>

<style>
  .hero-design-canvas {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  /* 1. Ambient Studio Atmospheric Glow */
  .canvas-ambient {
    position: absolute;
    inset: 0;
    opacity: .24;
    filter: blur(90px);
    transition: opacity .6s ease;
  }
  :global([data-theme="dark"]) .canvas-ambient {
    opacity: .32;
    filter: blur(110px);
  }
  .orb-primary {
    position: absolute;
    top: -8%;
    right: 18%;
    width: 32rem;
    height: 32rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);
    animation: orbFloat1 18s ease-in-out infinite alternate;
  }
  .orb-secondary {
    position: absolute;
    bottom: 0%;
    left: 12%;
    width: 26rem;
    height: 26rem;
    border-radius: 50%;
    background: radial-gradient(circle, #f59e0b 0%, transparent 70%);
    animation: orbFloat2 22s ease-in-out infinite alternate;
  }
  .orb-tertiary {
    position: absolute;
    top: 35%;
    left: 45%;
    width: 18rem;
    height: 18rem;
    border-radius: 50%;
    background: radial-gradient(circle, #818cf8 0%, transparent 70%);
    animation: orbFloat3 16s ease-in-out infinite alternate;
    opacity: .5;
  }

  @keyframes orbFloat1 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-45px, 40px) scale(1.12); }
  }
  @keyframes orbFloat2 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(40px, -35px) scale(1.08); }
  }
  @keyframes orbFloat3 {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-25px, 20px) scale(1.15); }
  }

  /* 2. SVG Stage & Organic Vignette */
  .canvas-svg-stage {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse at 50% 45%, black 45%, transparent 88%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 45%, black 45%, transparent 88%);
  }
  .canvas-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* 3. Baseline & Guide Lines */
  .guide-line {
    stroke: var(--color-ink);
    stroke-width: 1;
    opacity: .12;
  }
  :global([data-theme="dark"]) .guide-line {
    stroke: var(--color-surface);
    opacity: .14;
  }
  .guide-cap { stroke-dasharray: 6 8; }
  .guide-mean { stroke-dasharray: 2 6; opacity: .08; }
  .guide-base {
    stroke: var(--color-accent);
    stroke-width: 1.2;
    opacity: .35;
  }
  .guide-desc { stroke-dasharray: 4 6; opacity: .08; }

  .tick-mark {
    stroke: var(--color-ink);
    stroke-width: 1;
    opacity: .22;
  }
  :global([data-theme="dark"]) .tick-mark {
    stroke: var(--color-surface);
    opacity: .28;
  }
  .tick-circle {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: .5;
  }

  /* 4. Golden Ratio Geometry */
  .golden-spin-group {
    animation: slowSpin 90s linear infinite;
    transform-origin: 200px 200px;
  }
  @keyframes slowSpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .phi-ring {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 1;
    opacity: .12;
  }
  :global([data-theme="dark"]) .phi-ring {
    stroke: var(--color-surface);
    opacity: .18;
  }
  .phi-outer { stroke-dasharray: 8 8; }
  .phi-mid { stroke-dasharray: 4 6; }
  .phi-inner { stroke-dasharray: 2 4; stroke: var(--color-accent); opacity: .3; }

  .phi-axis {
    stroke: var(--color-line);
    stroke-width: 1;
    stroke-dasharray: 3 6;
    opacity: .35;
  }
  .phi-diagonal {
    stroke: var(--color-line);
    stroke-width: 1;
    opacity: .25;
  }
  .phi-node {
    fill: var(--color-accent);
    opacity: .6;
  }

  /* Dynamic Fibonacci Spiral Curve */
  .fibonacci-spiral {
    stroke: var(--color-accent);
    stroke-width: 1.8;
    stroke-dasharray: 1400;
    opacity: .65;
    animation: spiralFlow 16s cubic-bezier(.45, 0, .25, 1) infinite;
  }
  @keyframes spiralFlow {
    0% { stroke-dashoffset: 1400; opacity: .15; }
    50% { stroke-dashoffset: 0; opacity: .8; }
    100% { stroke-dashoffset: -1400; opacity: .15; }
  }

  /* 5. Fluid Bézier Waves & Handles */
  .bezier-wave {
    stroke-width: 1.8;
    transition: transform .4s ease;
  }
  .wave-primary {
    animation: waveDrift1 14s ease-in-out infinite alternate;
  }
  .wave-secondary {
    opacity: .45;
    stroke-dasharray: 12 8;
    animation: waveDrift2 18s ease-in-out infinite alternate;
  }
  .wave-ghost {
    stroke: var(--color-ink);
    stroke-width: 5;
    opacity: .03;
    animation: waveDrift1 14s ease-in-out infinite alternate;
  }
  :global([data-theme="dark"]) .wave-ghost {
    stroke: var(--color-surface);
    opacity: .05;
  }

  @keyframes waveDrift1 {
    0% { transform: translateY(0) rotate(0deg); }
    100% { transform: translateY(-14px) rotate(1.2deg); }
  }
  @keyframes waveDrift2 {
    0% { transform: translateY(0) rotate(0deg); }
    100% { transform: translateY(16px) rotate(-1.5deg); }
  }

  /* Tangent System (Active Vector Handle) */
  .tangent-node-primary {
    animation: handleFloatPrimary 8s ease-in-out infinite alternate;
    transform-origin: 700px 240px;
  }
  @keyframes handleFloatPrimary {
    0% { transform: translate(700px, 240px) rotate(0deg); }
    100% { transform: translate(700px, 226px) rotate(3deg); }
  }

  .tangent-rod {
    stroke: var(--color-accent);
    stroke-width: 1.2;
    stroke-dasharray: 2 3;
    opacity: .75;
  }
  .tangent-handle {
    fill: var(--color-surface);
    stroke: var(--color-accent);
    stroke-width: 1.6;
  }
  .anchor-square {
    fill: var(--color-accent);
  }
  .anchor-aura {
    stroke: var(--color-accent);
    stroke-width: 1;
    fill: none;
    animation: anchorPulse 3.5s ease-out infinite;
  }
  @keyframes anchorPulse {
    0% { transform: scale(.7); opacity: .7; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  .tangent-node-secondary {
    animation: handleFloatSecondary 11s ease-in-out infinite alternate;
    transform-origin: 360px 290px;
  }
  @keyframes handleFloatSecondary {
    0% { transform: translate(360px, 290px) rotate(0deg); }
    100% { transform: translate(360px, 298px) rotate(-2.5deg); }
  }
  .tangent-rod-faint {
    stroke: var(--color-muted);
    stroke-width: 1;
    stroke-dasharray: 2 2;
    opacity: .3;
  }
  .tangent-handle-faint {
    fill: var(--color-surface);
    stroke: var(--color-muted);
    stroke-width: 1.2;
    opacity: .6;
  }
  .anchor-square-faint {
    fill: var(--color-muted);
    opacity: .6;
  }

  /* 6. Letterform Optical Geometry */
  .letterform-abstract {
    animation: opticalBreathe 12s ease-in-out infinite alternate;
    transform-origin: center;
  }
  @keyframes opticalBreathe {
    0% { opacity: .7; transform: translate(180px, 260px) scale(1); }
    100% { opacity: .95; transform: translate(180px, 252px) scale(1.02); }
  }
  .optical-circle {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1;
    stroke-dasharray: 3 6;
    opacity: .25;
  }
  .circle-left { animation: slowSpin 60s linear infinite reverse; transform-origin: 120px 140px; }
  .circle-right { animation: slowSpin 60s linear infinite; transform-origin: 210px 140px; }

  .optical-path {
    stroke: var(--color-ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    opacity: .18;
  }
  :global([data-theme="dark"]) .optical-path {
    stroke: var(--color-surface);
    opacity: .25;
  }
  .crosshair {
    stroke: var(--color-accent);
    stroke-width: 1;
    opacity: .5;
  }

  /* 7. Grid Overlay */
  .canvas-grid-overlay {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size: 6rem 6rem;
    opacity: .22;
    mask-image: radial-gradient(ellipse at 50% 40%, black 35%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 40%, black 35%, transparent 85%);
  }
  :global([data-theme="dark"]) .canvas-grid-overlay {
    opacity: .18;
  }

  /* Accessibility & Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .fibonacci-spiral,
    .wave-primary,
    .wave-secondary,
    .wave-ghost,
    .tangent-node-primary,
    .tangent-node-secondary,
    .golden-spin-group,
    .circle-left,
    .circle-right,
    .orb-primary,
    .orb-secondary,
    .orb-tertiary,
    .anchor-aura,
    .letterform-abstract {
      animation: none !important;
    }
    .fibonacci-spiral {
      stroke-dashoffset: 0;
      opacity: .6;
    }
  }
</style>
