# PostgreSQL
DATABASE_URL=postgresql://user@127.0.0.1:5432/monfolio_cms

# Payload
PAYLOAD_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Origin of the Astro frontend, allowed for CORS + CSRF
WEB_URL=http://localhost:4321

# Optional deploy hook fired after content changes. Leave empty to disable.
REVALIDATE_WEBHOOK_URL=
