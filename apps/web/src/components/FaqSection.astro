---
import type { Faq, Marker, SectionCopy } from '@monfolio/content';
import SectionMarker from './SectionMarker.astro';

const { faqs, marker, copy } = Astro.props as {
  faqs: Faq[];
  marker: Marker;
  copy: SectionCopy;
};
---

<section id="faq" class="bg-surface-lift px-5 py-20 sm:px-8 sm:py-28 lg:px-8">
  <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.7fr_1.3fr]" data-fade-stagger>
    <div class="faq-content">
      <SectionMarker number={marker.number} label={marker.label} />
      <h2 class="display-heading" set:html={copy.heading} />
      <p class="mt-8 max-w-xs text-sm leading-7 text-muted">{copy.intro}</p>
    </div>
    <div class="faq-list">
      {faqs.map((faq, index) => (
        <article class="faq-item">
          <button type="button" aria-expanded="false" aria-controls={`faq-answer-${index}`}>
            <span>{faq.question}</span>
            <i>+</i>
          </button>
          <div id={`faq-answer-${index}`} class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-content .display-heading{margin-bottom:3rem}
  .faq-list{max-width:52rem;margin-left:auto;display:flex;flex-direction:column;gap:.85rem}
  .faq-item{border-radius:1.125rem;background:var(--color-surface);border:1px solid var(--color-line);padding:0 1.5rem;transition:border-color .3s ease,box-shadow .3s ease}
  .faq-item:hover,
  .faq-item.is-open{border-color:color-mix(in srgb,var(--color-accent) 40%,var(--color-line));box-shadow:0 10px 24px -6px rgba(7,13,20,.05)}
  .faq-item button{display:flex;width:100%;justify-content:space-between;align-items:center;gap:1rem;padding:1.25rem 0;text-align:left;color:var(--color-ink);font-size:14px;font-weight:600;background:transparent;border:none;cursor:pointer}
  .faq-item button i{color:var(--color-accent);font-size:1.5rem;font-style:normal;line-height:1;transition:transform .3s}
  .faq-item button[aria-expanded=true] i{transform:rotate(45deg)}
  .faq-answer{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s var(--ease-studio)}
  .faq-answer p{overflow:hidden;color:var(--color-muted);font-size:13px;line-height:1.7}
  .faq-item.is-open .faq-answer{grid-template-rows:1fr}
  .faq-item.is-open .faq-answer p{padding:0 2rem 1.4rem 0}
</style>

<script>
  document.querySelectorAll('.faq-item button').forEach((button) => button.addEventListener('click', () => {
    const item = button.closest('.faq-item');
    const open = item?.classList.toggle('is-open');
    button.setAttribute('aria-expanded', String(open));
  }));
</script>
