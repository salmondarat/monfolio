---
import { paragraphHtml, type ProjectBlock } from '@monfolio/content';

type SplitBlock = Extract<ProjectBlock, { blockType: 'split' }>;

const { block } = Astro.props as { block: SplitBlock };
const paragraphs = paragraphHtml(block.text);
---
<div class="bl-split" data-side={block.imageSide}>
  <div class="bl-split-text">
    {paragraphs.map((paragraph) => <p set:html={paragraph} />)}
  </div>
  <div class="bl-split-media">
    <img src={block.url} alt={block.alt} loading="lazy" decoding="async" />
  </div>
</div>

<style>
  .bl-split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 2.5rem;
    align-items: center;
  }
  .bl-split[data-side='left'] .bl-split-media {
    order: -1;
  }
  .bl-split-text p {
    margin: 0;
  }
  .bl-split-text p + p {
    margin-top: 1rem;
  }
  .bl-split-text p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .bl-split-media {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    aspect-ratio: 4 / 3;
    background: var(--color-surface-lift);
  }
  .bl-split-media::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .bl-split-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (max-width: 48rem) {
    .bl-split {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .bl-split[data-side='right'] .bl-split-media {
      order: -1;
    }
  }
</style>
