---
import type { ProjectBlock } from '@monfolio/content';

type QuoteBlock = Extract<ProjectBlock, { blockType: 'quote' }>;

const { block } = Astro.props as { block: QuoteBlock };
---
<figure class="bl-quote">
  <blockquote>
    <p set:html={block.text} />
  </blockquote>
  {block.attribution && <figcaption class="bl-attribution">{block.attribution}</figcaption>}
</figure>

<style>
  .bl-quote {
    margin: 0;
  }
  .bl-quote blockquote {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 3px solid var(--color-accent);
  }
  .bl-quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .bl-attribution {
    margin-top: 1rem;
    padding-left: 1.5rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }
</style>
