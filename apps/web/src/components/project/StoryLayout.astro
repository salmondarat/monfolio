---
import type { Category, Project, ProjectBlock } from '@monfolio/content';
import NextProject from './NextProject.astro';
import ProjectCard from '../ProjectCard.astro';
import TextBlock from './blocks/TextBlock.astro';
import ImageBlock from './blocks/ImageBlock.astro';
import GalleryBlock from './blocks/GalleryBlock.astro';
import QuoteBlock from './blocks/QuoteBlock.astro';
import StatsBlock from './blocks/StatsBlock.astro';
import SplitBlock from './blocks/SplitBlock.astro';
import { composeFallbackBlocks } from '../../lib/blocks';

const { project, next, category, related } = Astro.props as {
  project: Project;
  next: Project;
  category?: Category;
  related: Project[];
};

const categoryName = category?.name ?? project.category.split('/')[0].trim();

const cover = project.gallery[0] ??
  (project.image ? { url: project.image, alt: project.imageAlt } : undefined);

const blocks: ProjectBlock[] =
  project.blocks.length > 0 ? project.blocks : composeFallbackBlocks(project);

const widthClass = (block: ProjectBlock): string => {
  switch (block.blockType) {
    case 'image':
      return block.width === 'wide'
        ? 'stream-item-wide'
        : block.width === 'narrow'
          ? 'stream-item-narrow'
          : 'stream-item';
    case 'gallery':
    case 'split':
      return 'stream-item-wide';
    default:
      return 'stream-item';
  }
};
---
<article class="story">
  {cover && (
    <div class="story-cover-wrap">
      <figure class="story-cover">
        <img src={cover.url} alt={cover.alt} loading="eager" decoding="async" />
      </figure>
    </div>
  )}

  <header class="story-head">
    <p class="story-eyebrow">{categoryName} · {project.year}</p>
    <h1 class="story-title">{project.title}</h1>
    {project.description && <p class="story-lede">{project.description}</p>}
  </header>

  <div class="story-body">
    <aside class="story-rail">
      <div class="rail-block">
        <span class="rail-label">Year</span>
        <span class="rail-value">{project.year}</span>
      </div>
      {project.deliverables.length > 0 && (
        <div class="rail-block">
          <span class="rail-label">Deliverables</span>
          <ul class="rail-list">
            {project.deliverables.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )}
      {project.metrics.length > 0 && (
        <div class="rail-block">
          <span class="rail-label">Results</span>
          <ul class="rail-list">
            {project.metrics.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )}
    </aside>

    <div class="story-stream">
      {blocks.map((block) => (
        <div class:list={['stream-item', widthClass(block)]} data-story-reveal>
          {block.blockType === 'text' && <TextBlock block={block} />}
          {block.blockType === 'image' && <ImageBlock block={block} />}
          {block.blockType === 'gallery' && <GalleryBlock block={block} />}
          {block.blockType === 'quote' && <QuoteBlock block={block} />}
          {block.blockType === 'stats' && <StatsBlock block={block} />}
          {block.blockType === 'split' && <SplitBlock block={block} />}
        </div>
      ))}
    </div>
  </div>

  {related.length > 0 && (
    <section class="story-related">
      <p class="related-heading">More in {categoryName}</p>
      <div class="related-grid">
        {related.map((entry, index) => <ProjectCard project={entry} index={index} />)}
      </div>
    </section>
  )}

  <footer class="story-footer">
    <NextProject project={next} />
    <a class="story-top" href="#top">Back to top ↑</a>
  </footer>
</article>

<style>
  .story {
    display: block;
    padding-bottom: 1rem;
  }

  /* ---------------------------------------------------------- cover */
  .story-cover-wrap {
    max-width: 80rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 0;
  }
  .story-cover {
    position: relative;
    overflow: hidden;
    margin: 0;
    border-radius: 1.25rem;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-lift);
  }
  .story-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 10%, transparent);
  }
  .story-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --------------------------------------------------------- header */
  .story-head {
    max-width: 80rem;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 0;
  }
  .story-eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .story-title {
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .story-lede {
    margin: 1.25rem 0 0;
    max-width: 42rem;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  /* ----------------------------------------------------- body + rail */
  .story-body {
    max-width: 80rem;
    margin: 3.5rem auto 0;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
  }
  .story-rail {
    position: sticky;
    top: 6.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .rail-block {
    border-top: 1px solid var(--color-line);
    padding-top: 0.9rem;
  }
  .rail-label {
    display: block;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .rail-value {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .rail-list {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rail-list li {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* --------------------------------------------------- block stream */
  .story-stream {
    display: grid;
    grid-template-columns: 1fr min(100%, 44rem) 1fr;
    row-gap: 3rem;
    align-items: start;
    min-width: 0;
  }
  .stream-item {
    grid-column: 2;
    min-width: 0;
  }
  .stream-item-wide {
    grid-column: 1 / -1;
  }
  .stream-item-narrow {
    grid-column: 2;
    justify-self: center;
    width: min(100%, 30rem);
  }

  /* -------------------------------------------------------- related */
  .story-related {
    max-width: 80rem;
    margin: 5.5rem auto 0;
    padding: 0 1.5rem;
  }
  .related-heading {
    margin: 0 0 1.5rem;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
  }

  /* --------------------------------------------------------- footer */
  .story-footer {
    max-width: 80rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }
  .story-top {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .story-top:hover {
    color: var(--color-accent);
  }

  @media (max-width: 64rem) {
    .story-body {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .story-rail {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 2.5rem;
    }
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 48rem) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const items = document.querySelectorAll<HTMLElement>('[data-story-reveal]');

  if (!prefersReduced && items.length > 0) {
    for (const item of items) {
      gsap.fromTo(
        item,
        { opacity: 0, y: 20 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: { trigger: item, start: 'top 88%', once: true },
        },
      );
    }
  }
</script>
