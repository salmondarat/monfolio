---
import type { Project } from '../data/projects';
import ProjectVisual from './ProjectVisual.astro';
const { project, index } = Astro.props as { project: Project; index?: number };

const rawCat = project.category.toLowerCase();
const categorySlug = rawCat.includes('custom')
  ? 'custom-build'
  : rawCat.includes('design')
    ? 'design-system'
    : rawCat.includes('migration')
      ? 'migration'
      : 'growth';
---
<article
  class="project-card"
  data-category={categorySlug}
  data-index={index}
  data-fade-stagger
>
  <div class="project-visual-wrap">
    <ProjectVisual image={project.image} imageAlt={project.imageAlt} />
  </div>
  <div class="project-caption">
    <div class="project-info">
      <div class="project-meta-row">
        <span class="project-cat-pill">{project.category.split('/')[0].trim()}</span>
        <span class="project-year">{project.year}</span>
      </div>
      <h3 class="project-title">{project.title}</h3>
      <p class="project-desc">{project.description}</p>
      {project.metrics && (
        <div class="project-metrics">
          {project.metrics.map((metric) => <span class="metric">{metric}</span>)}
        </div>
      )}
    </div>
    <div class="project-footer">
      <span class="project-action">View case study</span>
      <span class="project-arrow" aria-hidden="true">↗</span>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-radius: 1.25rem;
    background: var(--color-surface-lift);
    border: 1px solid var(--color-line);
    padding: 1.25rem;
    min-width: 0;
    transition: transform .5s var(--ease-studio), box-shadow .5s var(--ease-studio), border-color .3s ease, opacity .4s ease;
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -10px rgba(7, 13, 20, 0.1);
    border-color: color-mix(in srgb, var(--color-accent) 45%, var(--color-line));
  }
  .project-visual-wrap {
    overflow: hidden;
    border-radius: 0.875rem;
  }
  .project-card:hover :global(.project-visual img) {
    transform: scale(1.04);
  }
  .project-caption {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    padding-top: 1.25rem;
  }
  .project-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.65rem;
  }
  .project-cat-pill {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .project-year {
    font-size: 11px;
    font-weight: 600;
    color: var(--color-muted);
  }
  .project-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.15;
    color: var(--color-ink);
    transition: color .3s ease;
  }
  .project-card:hover .project-title {
    color: var(--color-accent);
  }
  .project-desc {
    margin-top: 0.5rem;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .project-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }
  .metric {
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    color: var(--color-muted);
    font-size: 10px;
    font-weight: 600;
    background: color-mix(in srgb, var(--color-surface) 60%, transparent);
  }
  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--color-line) 60%, transparent);
  }
  .project-action {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-ink);
    transition: color .3s ease;
  }
  .project-card:hover .project-action {
    color: var(--color-accent);
  }
  .project-arrow {
    display: flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    font-size: 12px;
    color: var(--color-ink);
    background: var(--color-surface);
    transition: all .4s var(--ease-studio);
  }
  .project-card:hover .project-arrow {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
    transform: rotate(45deg);
  }
</style>
