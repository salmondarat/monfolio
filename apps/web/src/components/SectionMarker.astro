---
const { number, label } = Astro.props;
---
<div class="section-marker"><span>{number}</span><b>{label}</b></div>
<style>
  .section-marker{display:flex;align-items:center;gap:.65rem;margin-bottom:2rem;color:var(--color-muted);font-size:24px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}.section-marker>span{display:grid;width:1.5rem;height:1.5rem;place-items:center;border-radius:50%;background:var(--color-ink);color:var(--color-surface);font-size:10px;letter-spacing:0}.section-marker b{font-weight:700}
</style>
