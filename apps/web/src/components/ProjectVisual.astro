---
const { image, imageAlt } = Astro.props as { image: string; imageAlt: string };
---
<div class="project-visual">
  {image ? <img src={image} alt={imageAlt} loading="lazy" decoding="async" /> : null}
</div>

<style>
  .project-visual { position:relative; overflow:hidden; aspect-ratio:16/10; border-radius:0.875rem; background:var(--color-surface-lift); }
  .project-visual::after { content:''; position:absolute; inset:0; border-radius:inherit; pointer-events:none; box-shadow:inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 10%, transparent); }
  .project-visual img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .7s var(--ease-studio); }
</style>
