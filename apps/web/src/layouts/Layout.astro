---
import '../styles/global.css';
import type { SiteSettingsContent } from '@monfolio/content';

const { settings, title, description } = Astro.props as {
  settings: SiteSettingsContent;
  title?: string;
  description?: string;
};

const pageTitle = title ?? settings.title;
const pageDescription = description ?? settings.description;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={settings.ogImage} />
    <meta name="theme-color" content={settings.themeColor} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={settings.favicon} />
    <title>{pageTitle}</title>
  </head>
  <body><slot /></body>
  <script is:inline>
    const storedTheme = localStorage.getItem('monfolio-theme');
    const theme = storedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  </script>
</html>
