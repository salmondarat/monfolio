---
import type { Project } from '@monfolio/content';
import {
  getAnnouncement,
  getCategories,
  getNavigation,
  getProjects,
  getSiteSettings,
} from '@monfolio/content';
import SiteShell from '../../../layouts/SiteShell.astro';
import StoryLayout from '../../../components/project/StoryLayout.astro';

export const getStaticPaths = async () => {
  const projects = await getProjects();

  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
    },
  }));
};

const { project, next } = Astro.props as { project: Project; next: Project };

const [categories, projects] = await Promise.all([getCategories(), getProjects()]);
const category = categories.find((entry) => entry.slug === project.categorySlug);
const related = projects
  .filter((entry) => entry.slug !== project.slug && entry.categoryKey === project.categoryKey)
  .slice(0, 3);

const [settings, navigation, announcement] = await Promise.all([
  getSiteSettings(),
  getNavigation(),
  getAnnouncement(),
]);

const title = `${project.title} — ${settings.title}`;
const description = project.description;
---
<SiteShell
  settings={settings}
  navigation={navigation}
  announcement={announcement}
  title={title}
  description={description}
>
  <StoryLayout project={project} next={next} category={category} related={related} />
</SiteShell>
