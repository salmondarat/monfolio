---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import SectionMarker from '../components/SectionMarker.astro';
import FooterLinks from '../components/FooterLinks.astro';
import FaqSection from '../components/FaqSection.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import HeroGridAnimation from '../components/HeroGridAnimation.astro';
import { projects } from '../data/projects';
import { services } from '../data/services';

const categorySlug = (category: string) => {
  const raw = category.toLowerCase();
  return raw.includes('custom') ? 'custom-build' : raw.includes('design') ? 'design-system' : raw.includes('migration') ? 'migration' : 'growth';
};
const filterCounts = {
  all: projects.length,
  'custom-build': projects.filter((p) => categorySlug(p.category) === 'custom-build').length,
  'design-system': projects.filter((p) => categorySlug(p.category) === 'design-system').length,
  migration: projects.filter((p) => categorySlug(p.category) === 'migration').length,
  growth: projects.filter((p) => categorySlug(p.category) === 'growth').length,
};
---
<Layout>
  <div class="site-shell" id="top">
    <AnnouncementBar />
    <Header />
    <main>
      <section class="hero-stage bg-surface px-5 sm:px-8 lg:px-8">
        <HeroGridAnimation />
        <div class="relative z-10 mx-auto flex min-h-[calc(100svh-7.5rem)] max-w-7xl flex-col pt-8 sm:pt-10">
          <div class="hero-meta"><span class="studio-badge"><i></i> Design &amp; build studio</span><span class="location-badge">Monfolio Studio — Jakarta + remote</span></div>
          <h1 class="hero-title mt-6 max-w-4xl font-display text-[clamp(2.4rem,4.5vw,4.5rem)] font-semibold leading-[.95] tracking-[-.07em]">A partner to ambitious <span class="client-chip">Northwind <i>↗</i></span> marketing teams, accelerating growth with next-level <span class="showreel-chip">websites <b>▶</b></span>.</h1>
          <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div class="flex flex-col items-start gap-6">
              <p class="max-w-md text-[15px] leading-[1.7] text-muted">We design and build custom sites that make your team faster: clear systems, considered motion and no mystery after launch.</p>
              <div class="flex flex-wrap gap-3">
                <a class="button button-orange rolling-button" href="#contact"><span>Start a project ↗</span><span aria-hidden="true">Start a project ↗</span></a>
                <a class="button button-outline rolling-button" href="#work"><span>Explore our work ↓</span><span aria-hidden="true">Explore our work ↓</span></a>
              </div>
            </div>
            <div class="ide-stack">
              <div class="ide-carousel" aria-hidden="true">
                <figure class="ide-card" data-ide-card>
                  <img src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?q=80&w=800&auto=format&fit=crop" alt="" loading="lazy" decoding="async" />
                  <figcaption><b>Dashboard</b><span>01 / 03</span></figcaption>
                </figure>
                <figure class="ide-card" data-ide-card>
                  <img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=800&auto=format&fit=crop" alt="" loading="lazy" decoding="async" />
                  <figcaption><b>Minimal landing</b><span>02 / 03</span></figcaption>
                </figure>
                <figure class="ide-card" data-ide-card>
                  <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?q=80&w=800&auto=format&fit=crop" alt="" loading="lazy" decoding="async" />
                  <figcaption><b>Social media</b><span>03 / 03</span></figcaption>
                </figure>
              </div>
              <div class="ide-window" aria-hidden="true">
                <div class="ide-chrome"><span class="ide-dot"></span><span class="ide-dot"></span><span class="ide-dot"></span><span class="ide-tab">site.config</span></div>
                <div class="ide-body">
                  <pre class="ide-code"><code id="ide-code"><span class="ide-caret"></span></code></pre>
                  <div class="ide-results is-hidden">
                    <figure class="ide-result"><img src="https://images.unsplash.com/photo-1581291518857-4e27b48ff24e?q=80&w=400&auto=format&fit=crop" alt="" loading="lazy" decoding="async" /><figcaption>Dashboard</figcaption></figure>
                    <figure class="ide-result"><img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=400&auto=format&fit=crop" alt="" loading="lazy" decoding="async" /><figcaption>Minimal landing</figcaption></figure>
                    <figure class="ide-result"><img src="https://images.unsplash.com/photo-1610701596007-11502861dcfa?q=80&w=400&auto=format&fit=crop" alt="" loading="lazy" decoding="async" /><figcaption>Social media</figcaption></figure>
                  </div>
                </div>
                <div class="ide-status"><span id="ide-status">ready</span><span class="ide-progress"><i id="ide-bar"></i></span></div>
              </div>
            </div>
          </div>
          <div class="availability mt-auto pt-4 pb-4"><i></i> Available for Q4 builds <span>· 2 project slots</span></div>
        </div>
        <div class="client-marquee mt-16 pb-10">
          <div class="marquee-track">
            {['Northwind','Atlas Labs','Mora','Fieldwork','Kite','Northwind','Atlas Labs','Mora'].map((name) => (
              <span><b>{name.slice(0,1)}</b>{name}</span>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="bg-surface-lift px-5 py-20 sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl" data-fade-stagger>
          <SectionMarker number="1" label="How we work" />
          <div class="intro-head">
            <h2 class="display-heading">Design-driven craft, built to give marketing teams <em>leverage.</em></h2>
            <p>We explore, prototype and build alongside the people who will run the site. The result is a useful system, not a handoff-shaped problem.</p>
          </div>
          <div class="intro-tiles">
            <div class="intro-tile tile-studio">
              <div class="tile-orbit"></div>
              <div class="caption-card"><span>Monfolio studio</span><small>Working sessions in Jakarta</small></div>
            </div>
            <div class="intro-tile tile-system">
              <div class="system-lines"></div>
              <div class="caption-card dark"><span>Figma → Build</span><small>Component libraries that stay coherent</small></div>
            </div>
          </div>
          <div class="pillars">
            {[
              ['01 · Architecture','Design systems that scale','A content model that makes the next page easier, not harder.'],
              ['02 · Motion & UX','Interaction with a job to do','Motion that orients, explains or rewards attention.'],
              ['03 · Growth partnership','A studio that stays useful','A clear handoff, a shared backlog and help when the next launch arrives.']
            ].map(([label, title, body]) => (
              <article class="pillar-card">
                <span>{label}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="work" class="bg-surface px-5 py-20 sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="section-head" data-fade-stagger>
            <SectionMarker number="2" label="Selected builds" />
            <div class="head-row">
              <h2 class="display-heading">Sites that do<br /><em>useful work.</em></h2>
              <p>A few custom builds, migrations and systems made with marketing teams who needed momentum.</p>
            </div>
          </div>
          <article class="featured-build" data-fade-stagger>
            <div class="featured-copy">
              <span class="orange-badge">Featured build</span>
              <small>Mora Coffee / Custom build</small>
              <h3>A warmer shop for slow mornings and good company.</h3>
              <p>A conversion-ready shop with CMS-driven stories and a publishing workflow the team can own.</p>
              <div>
                <a class="white-chip" href="#contact">Explore case study ↗</a>
                <span class="read-time">Read 3 min</span>
              </div>
            </div>
            <div class="featured-visual">
              <div class="card-stack" role="button" aria-label="Toggle Mora Coffee project cards" tabindex="0">
                <div class="card-back" aria-hidden="true">
                  <img src="https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?q=80&w=1600&auto=format&fit=crop" alt="Artisan coffee detail at Mora Coffee" loading="lazy" decoding="async" />
                  <span class="card-back-badge">Mora · Detail</span>
                </div>
                <div class="card-front"><ProjectVisual image={projects[0].image} imageAlt={projects[0].imageAlt} /></div>
              </div>
            </div>
          </article>
          <div class="projects-toolbar mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" data-fade-stagger>
            <div class="project-filters flex flex-wrap gap-2" role="group" aria-label="Filter projects">
              <button type="button" class="filter-tab is-active" data-filter="all" aria-pressed="true">All <span class="filter-count">({filterCounts.all})</span></button>
              <button type="button" class="filter-tab" data-filter="custom-build" aria-pressed="false">Custom builds <span class="filter-count">({filterCounts['custom-build']})</span></button>
              <button type="button" class="filter-tab" data-filter="design-system" aria-pressed="false">Design systems <span class="filter-count">({filterCounts['design-system']})</span></button>
              <button type="button" class="filter-tab" data-filter="migration" aria-pressed="false">Migrations <span class="filter-count">({filterCounts.migration})</span></button>
              <button type="button" class="filter-tab" data-filter="growth" aria-pressed="false">Growth <span class="filter-count">({filterCounts.growth})</span></button>
            </div>
            <span class="project-counter text-xs font-semibold text-muted" data-project-counter>Showing 4 of {projects.length} featured builds</span>
          </div>
          <div class="project-grid" data-max="4">
            {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
          </div>
          <div class="projects-actions mt-12 flex justify-center">
            <button type="button" class="button button-outline rolling-button" data-toggle-projects>
              <span>Show all {projects.length} projects ↓</span>
              <span aria-hidden="true">Show all {projects.length} projects ↓</span>
            </button>
          </div>
        </div>
      </section>

      <FaqSection />

      <section id="story" class="story-section bg-ink px-5 py-20 text-surface sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl" data-fade-stagger>
          <SectionMarker number="4" label="Our story" />
          <div class="story-head">
            <h2 class="story-title">Our <span class="w-chip">W</span> studio story.</h2>
            <p>Small enough to stay close to the work. Structured enough to make complex custom builds feel calm.</p>
          </div>
          <div class="story-video">
            <div class="story-art">
              <span class="story-circle"></span>
              <span class="story-spark">+</span>
              <span class="story-word">MAKE<br />SPACE</span>
            </div>
            <div class="play-wrap">
              <span class="play-ring"></span>
              <button type="button" aria-label="Play studio story">▶</button>
              <span class="watch-pill">Watch our story · 1:30</span>
            </div>
            <div class="story-bar">
              <span><i></i> Jakarta + remote / working worldwide</span>
              <small>Custom builds, made together</small>
            </div>
          </div>
        </div>
      </section>

      <TestimonialSection />

      <section id="services" class="bg-surface-lift px-5 py-20 sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl" data-fade-stagger>
          <SectionMarker number="6" label="Services" />
          <div class="head-row services-head">
            <h2 class="display-heading">Build once.<br /><em>Keep moving.</em></h2>
            <p>Bring us a launch, a legacy site or a backlog. We will help you choose the right shape of engagement.</p>
          </div>
          <div class="service-cells">
            {services.map((service) => (
              <article class="service-cell" data-service-cell>
                <div class="flex items-start justify-between">
                  <span class="text-sm font-bold text-orange">{service.number}</span>
                  <span class="service-plus">↗</span>
                </div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <ul>{service.items.map((item) => <li>{item}</li>)}</ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="contact-section bg-surface px-5 py-20 sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl" data-fade-stagger>
          <SectionMarker number="7" label="Let’s make & build together" />
          <h2 class="contact-title">Looking to level-up your site or ship a custom design? <em>Let’s build it.</em></h2>
          <div class="avatar-card">
            <div>
              <span class="eyebrow-label">The people behind the pixels</span>
              <h3>A small studio, close to the work.</h3>
            </div>
            <div class="avatar-stack">
              <span title="Maya — strategy">MS</span>
              <span title="Rafi — design">RP</span>
              <span title="Nadine — content">NP</span>
              <span title="You — next project">+</span>
            </div>
          </div>
          <div class="contact-bento">
            <div class="contact-form-wrap">
              <div class="success-card" data-success>
                <strong>✓</strong>
                <h3>Message received.</h3>
                <p>We’ll get back to you within one working day.</p>
                <button type="button" data-reset-form>Send another message</button>
              </div>
              <form class="contact-form" data-contact-form>
                <fieldset class="topic-group">
                  <legend>How can we help?</legend>
                  <span class="topic-row">
                    <button type="button" class="topic selected">Marketing website</button>
                    <button type="button" class="topic">Migration</button>
                    <button type="button" class="topic">Something else</button>
                  </span>
                </fieldset>
                <div class="field-row">
                  <label>Full name<input required name="name" placeholder="Your name" /></label>
                  <label>Email address<input required type="email" name="email" placeholder="you@company.com" /></label>
                </div>
                <label>Message<textarea required name="message" rows="5" placeholder="Tell us what you are building."></textarea></label>
                <div class="submit-row">
                  <button class="button button-orange" type="submit">Send message ↗</button>
                  <small>By sending this form, you agree to our privacy policy.</small>
                </div>
              </form>
            </div>
            <aside class="info-card">
              <div>
                <span class="eyebrow-label">Direct inquiries</span>
                <a href="mailto:hello@monfolio.studio">hello@monfolio.studio</a>
              </div>
              <div>
                <span class="eyebrow-label">Studio</span>
                <p>Jl. Kemang Raya 12<br />Jakarta, Indonesia</p>
              </div>
              <div>
                <span class="eyebrow-label">How we work</span>
                <ul>
                  <li>Custom design &amp; build</li>
                  <li>Remote-first studio</li>
                  <li>Response within 24 hours</li>
                </ul>
              </div>
            </aside>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer bg-ink px-5 py-16 text-surface sm:px-8 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="footer-banner">
          <div>
            <span>Work with us</span>
            <h2>Looking to level-up your site or launch a custom design? Start with a free consultation.</h2>
          </div>
          <a class="button button-orange" href="#contact">Start a conversation ↗</a>
        </div>
        <div class="footer-grid">
          <div class="footer-identity">
            <a href="#top">monfolio<span>.</span></a>
            <p>Design &amp; build studio for marketing teams that need a clearer way to ship.</p>
          </div>
          <FooterLinks title="Explore" links={[{label:'Home',href:'#top'},{label:'Work',href:'#work'},{label:'About',href:'#about'},{label:'FAQ',href:'#faq'},{label:'Reviews',href:'#reviews'},{label:'Contact',href:'#contact'}]} />
          <FooterLinks title="Case studies" links={projects.slice(0,5).map((project) => ({label: project.title, href: '#work'}))} />
          <FooterLinks title="Services" links={services.map((service) => ({label: service.title, href: '#services'}))} />
        </div>
        <div class="legal-row">
          <span>© Monfolio Studio · Jakarta, Indonesia</span>
          <span><a href="#contact">Privacy policy</a> · <a href="#contact">Cookie preferences</a> · <b>Designed &amp; built in-house</b></span>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .section-marker{display:flex;align-items:center;gap:.65rem;margin-bottom:2rem;color:var(--color-muted);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .section-marker>span{display:grid;width:1.5rem;height:1.5rem;place-items:center;border-radius:50%;background:var(--color-ink);color:var(--color-surface);font-size:10px;letter-spacing:0}
  .section-marker b{font-weight:700}
  .hero-stage{position:relative;overflow:hidden}
  .hero-grid{position:absolute;inset:0;background-image:linear-gradient(var(--color-line) 1px,transparent 1px),linear-gradient(90deg,var(--color-line) 1px,transparent 1px);background-size:6rem 6rem;opacity:.24;mask-image:linear-gradient(to bottom,black,transparent 75%)}
  .hero-meta{display:flex;justify-content:space-between;gap:1rem}
  .studio-badge,.location-badge{display:inline-flex;align-items:center;gap:.55rem;border:1px solid var(--color-line);border-radius:999px;padding:.55rem .8rem;color:var(--color-ink);font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .studio-badge i,.availability i{width:.45rem;height:.45rem;border-radius:50%;background:#16a36a;box-shadow:0 0 0 .2rem color-mix(in srgb,#16a36a 18%,transparent)}
  .location-badge{border-color:var(--color-ink);background:var(--color-ink);color:var(--color-surface)}
  .client-chip,.showreel-chip{display:inline-flex;align-items:center;gap:.5rem;border:1px solid var(--color-line);border-radius:999px;padding:.3rem .8rem .35rem;font-size:.25em;font-weight:600;letter-spacing:-.04em;vertical-align:middle}
  .client-chip{background:var(--color-ink);color:var(--color-surface)}
  .client-chip i{font-size:.7em;font-style:normal;color:var(--color-accent)}
  .showreel-chip{border-color:var(--color-accent);background:var(--color-accent);color:#070d14}
  .showreel-chip b{display:grid;width:1.8em;height:1.8em;place-items:center;border-radius:50%;background:var(--color-surface);font-size:.45em}
  .availability{display:flex;align-items:center;gap:.6rem;margin-top:2rem;color:var(--color-ink);font-size:11px;font-weight:700}
  .availability span{color:var(--color-muted);font-weight:500}
  .ide-stack{display:flex;flex-direction:column;gap:.6rem}
  .ide-carousel{position:relative;width:26rem;max-width:100%;height:9.5rem;perspective:1000px}
  .ide-card{position:absolute;left:50%;top:0;width:15rem;height:100%;margin:0;overflow:hidden;border-radius:1rem;border:1px solid rgba(255,255,255,.12);background:#0b1118;box-shadow:0 20px 40px -12px rgba(7,13,20,.4);transition:transform .6s cubic-bezier(.25,1,.5,1),opacity .6s;cursor:pointer}
  .ide-card img{display:block;width:100%;height:100%;object-fit:cover}
  .ide-card figcaption{position:absolute;left:.7rem;right:.7rem;bottom:.6rem;display:flex;align-items:center;justify-content:space-between;border-radius:999px;background:rgba(11,17,24,.82);backdrop-filter:blur(8px);padding:.35rem .65rem;color:#fff}
  .ide-card figcaption b{font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .ide-card figcaption span{color:rgba(255,255,255,.55);font-size:9px;font-weight:700}
  .ide-card[data-pos="center"]{transform:translate3d(-50%,0,0) scale(1);opacity:1;z-index:10}
  .ide-card[data-pos="left"]{transform:translate3d(-112%,0,-90px) scale(.85);opacity:.55;z-index:5}
  .ide-card[data-pos="right"]{transform:translate3d(12%,0,-90px) scale(.85);opacity:.55;z-index:5}
  .ide-card[data-pos="hidden"]{transform:translate3d(-50%,0,-180px) scale(.7);opacity:0;z-index:1;pointer-events:none}
  .ide-window{display:flex;flex-direction:column;width:26rem;max-width:100%;height:14rem;overflow:hidden;border-radius:1rem;border:1px solid color-mix(in srgb,#ffffff 14%,transparent);background:#0b1118;box-shadow:0 24px 48px -12px rgba(7,13,20,.35);font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace}
  .ide-chrome{display:flex;align-items:center;gap:.45rem;padding:.7rem .9rem;border-bottom:1px solid rgba(255,255,255,.08)}
  .ide-dot{width:.6rem;height:.6rem;border-radius:50%;background:rgba(255,255,255,.18)}
  .ide-dot:nth-child(1){background:#f15533}
  .ide-dot:nth-child(2){background:#e8b93c}
  .ide-dot:nth-child(3){background:#16a36a}
  .ide-tab{margin-left:.6rem;color:rgba(255,255,255,.55);font-size:10px;letter-spacing:.08em}
  .ide-code{display:block;height:100%;margin:0;padding:.9rem 1.1rem;font-size:11px;line-height:1.6;color:#dfe4ea;white-space:pre-wrap}
  .ide-body{position:relative;flex:1;min-height:0}
  .ide-results{position:absolute;inset:0;display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem;padding:1rem 1.1rem}
  .ide-results.is-hidden{display:none}
  .ide-result{margin:0}
  .ide-result img{display:block;width:100%;height:3.5rem;object-fit:cover;border-radius:.5rem;border:1px solid rgba(255,255,255,.1)}
  .ide-result figcaption{margin-top:.4rem;color:rgba(255,255,255,.6);font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .ide-code .tok.kw{color:#f15533}
  .ide-code .tok.str{color:#4ade80}
  .ide-code .tok.fn{color:#7dd3fc}
  .ide-caret{display:inline-block;width:.55rem;height:1.05em;transform:translateY(.18em);background:#f15533;animation:ide-blink 1s steps(1) infinite}
  @keyframes ide-blink{50%{opacity:0}}
  .ide-status{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.65rem 1.1rem;border-top:1px solid rgba(255,255,255,.08);color:rgba(255,255,255,.6);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .ide-status.is-done{color:#4ade80}
  .ide-progress{flex:1;max-width:8rem;height:3px;border-radius:999px;background:rgba(255,255,255,.12);overflow:hidden}
  .ide-progress i{display:block;height:100%;width:0;border-radius:999px;background:#f15533}
  .client-marquee{overflow:hidden;mask-image:linear-gradient(90deg,transparent,black 12%,black 88%,transparent)}
  .marquee-track{display:flex;width:max-content;gap:4rem;animation:marquee 25s linear infinite;color:var(--color-muted);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .marquee-track span{display:flex;align-items:center;gap:.7rem;white-space:nowrap}
  .marquee-track b{display:grid;width:1.8rem;height:1.8rem;place-items:center;border:1px solid currentColor;border-radius:50%;font-size:9px}
  @keyframes marquee{to{transform:translateX(-50%)}}
  .intro-head,.head-row{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:2rem;align-items:end;margin-bottom:4rem}
  .intro-head h2,.head-row h2{grid-column:span 8}
