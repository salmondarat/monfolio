  .story-art{position:absolute;inset:0;background:radial-gradient(circle at 65% 38%,color-mix(in srgb,var(--color-accent) 30%,transparent),transparent 25%),linear-gradient(135deg,var(--color-surface),var(--color-surface-lift))}
  .story-circle{position:absolute;top:15%;right:12%;width:45%;aspect-ratio:1;border:1px solid var(--color-accent);border-radius:50%;box-shadow:0 0 0 2rem color-mix(in srgb,var(--color-accent) 8%,transparent),0 0 0 5rem color-mix(in srgb,var(--color-accent) 4%,transparent)}
