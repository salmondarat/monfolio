  /* Hero tablet: perapian layout — carousel & IDE berdampingan, spacing lebih ketat */
  @media(min-width:700px) and (max-width:1023px){
    .hero-grid-row{padding-bottom:4rem;gap:2.5rem}
    .ide-stack{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;align-items:start}
    .ide-carousel{aspect-ratio:16/11}
  }
  @media(prefers-reduced-motion:reduce){
    .marquee-track,.play-ring{animation:none}
    .card-back{animation:none!important}
    .service-cell:hover,.pillar-card:hover,.project-card:hover,.featured-build:hover .card-front,.featured-build:hover .card-back{transform:none!important;padding-left:2rem}
  }
</style>

<script>
  import gsap from 'gsap'; import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger); const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches; const mm=gsap.matchMedia();
  if(!reduce) mm.add('(min-width:700px)',()=>{gsap.utils.toArray<HTMLElement>('[data-fade-stagger]').forEach((block)=>gsap.fromTo(block.children,{opacity:0,y:14},{opacity:1,y:0,duration:.7,stagger:.08,ease:'power3.out',scrollTrigger:{trigger:block,start:'top 82%',once:true}}));});

  // Hero IDE build animation: type → build → deploy → results → pause → loop
  const ideCode=document.getElementById('ide-code'),ideStatus=document.getElementById('ide-status'),ideBar=document.getElementById('ide-bar'),ideCaret=document.querySelector('.ide-caret');
  const idePre=document.querySelector('.ide-code'),ideResults=document.querySelector('.ide-results');
  const IDE_LINES=[
    [['const ','kw'],['designer','var'],[' = {','pl']],
    [['  focus: ','pl'],["'brand & illustration'",'str'],[',','pl']],
    [['  work: ','pl'],["'real & shipped'",'str'],[',','pl']],
    [['}','pl']],
    [['','pl']],
    [['await ','kw'],['deploy','fn'],['();','pl']]
  ];
  const ideChars: { ch: string; c: string | null }[] = [];
  IDE_LINES.forEach((line, li) => {
    line.forEach(([text, cls]) => { for (const ch of text) ideChars.push({ ch, c: cls }); });
    if (li < IDE_LINES.length - 1) ideChars.push({ ch: '\n', c: null });
  });
  function ideReset() {
    if (ideCode && ideCaret) [...ideCode.childNodes].forEach((n) => { if (n !== ideCaret) n.remove(); });
    if (idePre) { (idePre as HTMLElement).style.display = 'block'; gsap.set(idePre, { opacity: 1 }); }
    if (ideResults) ideResults.classList.add('is-hidden');
    if (ideBar) gsap.set(ideBar, { width: '0%' });
    if (ideStatus) { ideStatus.textContent = 'ready'; ideStatus.classList.remove('is-done'); }
  }
  function ideFinish() {
    const ideResultEls = Array.from(document.querySelectorAll('.ide-result'));
    if (ideStatus) {
      ideStatus.textContent = '✓ deployed — portfolio live';
      ideStatus.classList.add('is-done');
    }
    if (reduce || !idePre || !ideResults) { if (idePre && ideResults) { (idePre as HTMLElement).style.display = 'none'; ideResults.classList.remove('is-hidden'); if (ideResultEls[0]) gsap.set(ideResultEls[0], { autoAlpha: 1 }); } return; }
    gsap.to(idePre, { opacity: 0, duration: .35, delay: .8, onComplete: () => {
      (idePre as HTMLElement).style.display = 'none';
      ideResults.classList.remove('is-hidden');
      // Show one full mockup at a time: assemble its elements one by one, hold, fade, next
      const tl = gsap.timeline({ onComplete: () => {
        setTimeout(() => { ideReset(); startTyping(); }, 2200);
      } });
      ideResultEls.forEach((result) => {
        tl.set(result, { autoAlpha: 1 });
        result.querySelectorAll('.mock-el').forEach((el) => {
          const pos = tl.duration() > 0 ? '-=.16' : undefined;
          if ((el as HTMLElement).classList.contains('mock-bar')) {
            tl.fromTo(el, { scaleY: 0 }, { scaleY: 1, duration: .3, ease: 'power2.out' }, pos);
          } else {
            tl.fromTo(el, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: .3, ease: 'power2.out' }, pos);
          }
        });
        tl.to(result, { autoAlpha: 0, duration: .35 }, '+=1.2');
      });
    } });
  }
  function startTyping() {
    if (reduce || !ideCode || !ideCaret) {
      if (ideCode && ideCaret) { const full = document.createElement('span'); full.textContent = ideChars.map((x) => x.ch).join(''); ideCode.insertBefore(full, ideCaret); }
      ideFinish();
      return;
    }
    let cur: HTMLSpanElement | null = null, curClass: string | null = null, i = 0;
    const step = () => {
      if (i >= ideChars.length) {
        if (ideStatus) { ideStatus.textContent = 'building site…'; }
        if (ideBar) gsap.fromTo(ideBar, { width: '0%' }, { width: '100%', duration: 1, ease: 'power2.inOut', onComplete: ideFinish });
        return;
      }
      const { ch, c } = ideChars[i++];
      if (!cur || curClass !== c) { cur = document.createElement('span'); if (c) cur.className = 'tok ' + c; ideCode.insertBefore(cur, ideCaret); curClass = c; }
      cur.textContent += ch;
      setTimeout(step, 26);
    };
    setTimeout(step, 600);
  }
  startTyping();

  // 3D design carousel above the IDE (autoplay, click-to-focus, pause on hover)
  const ideCarousel=document.querySelector<HTMLElement>('.ide-carousel');
  const ideCards=ideCarousel?Array.from(ideCarousel.querySelectorAll('.ide-card')):[];
  const ideDots=document.querySelector('.ide-dots');
  let ideActive=0,ideTimer: ReturnType<typeof setInterval> | undefined = undefined,ideSwiped=false;
  function ideUpdate(){
    const total=ideCards.length;
    ideCards.forEach((card,i)=>{
      const diff=(i-ideActive+total)%total;
      (card as HTMLElement).dataset.pos=diff===0?'center':diff===1?'right':diff===total-1?'left':'hidden';
    });
    if(ideDots) Array.from(ideDots.children).forEach((d,i)=>d.classList.toggle('is-active',i===ideActive));
  }
  function ideAutoStart(){
    if(reduce||!ideCards.length)return;
    clearInterval(ideTimer);
    ideTimer=setInterval(()=>{ideActive=(ideActive+1)%ideCards.length;ideUpdate();},3000);
  }
  ideCards.forEach((card,i)=>card.addEventListener('click',()=>{if(ideSwiped){ideSwiped=false;return;}ideActive=i;ideUpdate();ideAutoStart();}));
  ideCarousel?.addEventListener('mouseenter',()=>clearInterval(ideTimer));
  ideCarousel?.addEventListener('mouseleave',ideAutoStart);
  ideUpdate();
  ideAutoStart();

  // Mobile: dot indicator + swipe navigation untuk carousel
  if(ideDots&&ideCards.length){
    ideCards.forEach((_,i)=>{
      const d=document.createElement('button');
      d.type='button';d.className='ide-navdot';d.setAttribute('aria-label','Slide '+(i+1));
      d.addEventListener('click',()=>{ideActive=i;ideUpdate();ideAutoStart();});
      ideDots.appendChild(d);
    });
    ideUpdate();
  }
  let ideTouchX: number | null = null;
  ideCarousel?.addEventListener('touchstart',(e: TouchEvent)=>{ideTouchX=e.touches[0].clientX;ideSwiped=false;clearInterval(ideTimer);},{passive:true});
  ideCarousel?.addEventListener('touchmove',(e: TouchEvent)=>{if(ideTouchX!==null&&Math.abs(e.touches[0].clientX-ideTouchX)>10)ideSwiped=true;},{passive:true});
  ideCarousel?.addEventListener('touchend',(e: TouchEvent)=>{
    if(ideTouchX===null||!ideCards.length)return;
    const dx=e.changedTouches[0].clientX-ideTouchX;ideTouchX=null;
    if(Math.abs(dx)>40){ideActive=(ideActive+(dx<0?1:-1)+ideCards.length)%ideCards.length;ideUpdate();}
    ideAutoStart();
  });

  // Align IDE window bottom edge with the CTA buttons' bottom edge
  const ideStackEl=document.querySelector<HTMLElement>('.ide-stack'),ideWinEl=document.querySelector<HTMLElement>('.ide-window'),ctaEl=document.querySelector<HTMLElement>('.hero-grid-row .button-orange'),locBadge=document.querySelector<HTMLElement>('.location-badge');
  function alignIde(){
    if(!ideStackEl||!ideWinEl||!ctaEl||!locBadge) return;
    // Alignment hanya relevan di layout desktop (≥1024px); di mobile/tablet IDE tidak di-align
    if(window.matchMedia('(max-width:1023px)').matches){(ideStackEl as HTMLElement).style.marginTop='0px';(ideStackEl as HTMLElement).style.marginBottom='0px';return;}
    (ideStackEl as HTMLElement).style.marginTop='0px'; (ideStackEl as HTMLElement).style.marginBottom='0px';
    const carEl=ideStackEl.querySelector('.ide-carousel');
    const carH=carEl?(carEl as HTMLElement).offsetHeight:0;
    const need=ctaEl.getBoundingClientRect().bottom - locBadge.getBoundingClientRect().bottom - carH - (ideWinEl as HTMLElement).offsetHeight - 48;
    ideStackEl.style.marginTop=Math.max(24,need)+'px';
  }
  alignIde();
  window.addEventListener('resize',alignIde);
  window.addEventListener('load',alignIde);
  document.fonts?.ready.then(alignIde);
  [600,1500,3000].forEach((t)=>setTimeout(alignIde,t));

  document.querySelectorAll('.topic').forEach((topic)=>topic.addEventListener('click',()=>{document.querySelectorAll('.topic').forEach((item)=>item.classList.remove('selected'));topic.classList.add('selected');}));

  // Contact form → Payload REST API (no Astro server needed, site stays static)
  const CMS_URL = import.meta.env.PUBLIC_CMS_URL ?? 'http://localhost:3000';
  const form=document.querySelector<HTMLFormElement>('[data-contact-form]');
  const success=document.querySelector<HTMLElement>('[data-success]');
  form?.addEventListener('submit', async (event)=>{
    event.preventDefault();
    const submitButton=form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const payload=new FormData(form);
    submitButton?.setAttribute('disabled','true');
    try{
      const response=await fetch(`${CMS_URL}/api/form-submissions`,{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({
          name:payload.get('name'),
          email:payload.get('email'),
          message:payload.get('message'),
          topic:document.querySelector('.topic.selected')?.textContent?.trim()||'',
          source:window.location.href,
        }),
      });
      if(!response.ok) throw new Error(`Request failed with ${response.status}`);
      form.classList.add('is-hidden');
      success?.classList.add('is-visible');
    }catch(error){
      console.error(error);
      window.alert('We could not send your message. Please email us instead.');
    }finally{
      submitButton?.removeAttribute('disabled');
    }
  });
  document.querySelector('[data-reset-form]')?.addEventListener('click',()=>{form?.reset();form?.classList.remove('is-hidden');success?.classList.remove('is-visible');});
  const cardStack=document.querySelector<HTMLElement>('.card-stack');cardStack?.addEventListener('click',()=>cardStack.classList.toggle('is-swapped'));cardStack?.addEventListener('keydown',(e)=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();cardStack.classList.toggle('is-swapped');}});

  // Dynamic Projects Grid Filtering & Max Cards Display
  const projectGrid = document.querySelector<HTMLElement>('.project-grid');
  const projectCards = Array.from(document.querySelectorAll<HTMLElement>('.project-grid .project-card'));
  const filterTabs = document.querySelectorAll<HTMLElement>('.filter-tab');
  const toggleBtn = document.querySelector<HTMLElement>('[data-toggle-projects]');
  const counterEl = document.querySelector<HTMLElement>('[data-project-counter]');
  const maxDefault = Number(projectGrid?.dataset.max ?? 4) || 4;
  const showAllLabel = toggleBtn?.dataset.showAll || 'Show all';
  const showLessLabel = toggleBtn?.dataset.showLess || 'Show fewer';
  let currentFilter = 'all';
  let isExpanded = false;

  function updateProjectGrid(animate = false) {
    const matching = projectCards.filter(card => {
      if (currentFilter === 'all') return true;
      return card.dataset.category === currentFilter;
    });

    projectCards.forEach(card => card.classList.add('is-hidden'));

    const visible = isExpanded ? matching : matching.slice(0, maxDefault);
    visible.forEach(card => card.classList.remove('is-hidden'));

    if (counterEl) {
      counterEl.textContent = `Showing ${visible.length} of ${matching.length} ${matching.length === 1 ? 'build' : 'builds'}`;
    }

    if (toggleBtn) {
      if (matching.length <= maxDefault) {
        toggleBtn.style.display = 'none';
      } else {
        toggleBtn.style.display = 'inline-flex';
        const label = isExpanded ? `${showLessLabel} ↑` : `${showAllLabel} ${matching.length} projects ↓`;
        toggleBtn.querySelectorAll('span').forEach(s => s.textContent = label);
      }
    }

    if (animate && visible.length > 0) {
      gsap.fromTo(visible, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.35, stagger: 0.04, ease: 'power2.out' });
    }

    ScrollTrigger.refresh();
  }

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-pressed', 'false'); });
      tab.classList.add('is-active');
      tab.setAttribute('aria-pressed', 'true');
      currentFilter = tab.dataset.filter || 'all';
      isExpanded = false;
      updateProjectGrid(true);
    });
  });

  toggleBtn?.addEventListener('click', () => {
    isExpanded = !isExpanded;
    updateProjectGrid(true);
  });

  updateProjectGrid(false);
</script>
