  .card-back{z-index:1;background:var(--color-ink);border:1px solid color-mix(in srgb,var(--color-surface) 14%,transparent);box-shadow:0 16px 36px -6px rgba(0,0,0,.5);transform:translate(16px,14px) rotate(3deg);animation:slideBackCard 5.5s ease-in-out infinite alternate}
