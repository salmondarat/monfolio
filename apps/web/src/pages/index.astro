  .watch-pill{border-radius:999px;background:color-mix(in srgb,var(--color-ink) 80%,transparent);padding:.55rem .8rem;color:var(--color-surface);font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .story-bar{position:absolute;right:1.5rem;bottom:1.25rem;left:1.5rem;display:flex;justify-content:space-between;color:color-mix(in srgb,var(--color-ink) 78%,transparent);font-size:11px}
