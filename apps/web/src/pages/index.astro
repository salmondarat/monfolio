  .service-cell{position:relative;min-height:20rem;overflow:hidden;border-radius:1.25rem;border:1px solid var(--color-line);background:var(--color-surface);padding:2.25rem 2rem;transition:transform .5s var(--ease-studio),box-shadow .5s var(--ease-studio),border-color .3s ease}
