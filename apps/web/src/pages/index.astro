    if (ideBar) gsap.set(ideBar, { width: '0%' });
    if (ideStatus) { ideStatus.textContent = 'ready'; ideStatus.classList.remove('is-done'); }
  }
  function ideFinish() {
    if (ideStatus) {
      ideStatus.textContent = '✓ deployed — site is live';
      ideStatus.classList.add('is-done');
    }
    if (reduce || !idePre || !ideResults) { if (idePre && ideResults) { (idePre as HTMLElement).style.display = 'none'; ideResults.classList.remove('is-hidden'); } return; }
    gsap.to(idePre, { opacity: 0, duration: .35, delay: .8, onComplete: () => {
      (idePre as HTMLElement).style.display = 'none';
      ideResults.classList.remove('is-hidden');
      gsap.fromTo('.ide-result', { opacity: 0, y: 10 }, { opacity: 1, y: 0, duration: .45, stagger: .12, ease: 'power2.out', onComplete: () => {
        setTimeout(() => { ideReset(); startTyping(); }, 3200);
      } });
    } });
  }
  function startTyping() {
    if (reduce || !ideCode || !ideCaret) {
      if (ideCode && ideCaret) { const full = document.createElement('span'); full.textContent = ideChars.map((x) => x.ch).join(''); ideCode.insertBefore(full, ideCaret); }
      ideFinish();
      return;
    }
    let cur: HTMLSpanElement | null = null, curClass: string | null = null, i = 0;
    const step = () => {
      if (i >= ideChars.length) {
        if (ideStatus) { ideStatus.textContent = 'building site…'; }
        if (ideBar) gsap.fromTo(ideBar, { width: '0%' }, { width: '100%', duration: 1, ease: 'power2.inOut', onComplete: ideFinish });
        return;
      }
      const { ch, c } = ideChars[i++];
      if (!cur || curClass !== c) { cur = document.createElement('span'); if (c) cur.className = 'tok ' + c; ideCode.insertBefore(cur, ideCaret); curClass = c; }
      cur.textContent += ch;
      setTimeout(step, 26);
    };
    setTimeout(step, 600);
  }
  startTyping();

  // 3D design carousel above the IDE (autoplay, click-to-focus, pause on hover)
  const ideCarousel=document.querySelector('.ide-carousel');
  const ideCards=ideCarousel?Array.from(ideCarousel.querySelectorAll('.ide-card')):[];
  let ideActive=0,ideTimer: ReturnType<typeof setInterval> | null = null;
  function ideUpdate(){
    const total=ideCards.length;
    ideCards.forEach((card,i)=>{
      const diff=(i-ideActive+total)%total;
      (card as HTMLElement).dataset.pos=diff===0?'center':diff===1?'right':diff===total-1?'left':'hidden';
    });
  }
  function ideAutoStart(){
    if(reduce||!ideCards.length)return;
    clearInterval(ideTimer);
    ideTimer=setInterval(()=>{ideActive=(ideActive+1)%ideCards.length;ideUpdate();},3000);
  }
  ideCards.forEach((card,i)=>card.addEventListener('click',()=>{ideActive=i;ideUpdate();ideAutoStart();}));
  ideCarousel?.addEventListener('mouseenter',()=>clearInterval(ideTimer));
  ideCarousel?.addEventListener('mouseleave',ideAutoStart);
  ideUpdate();
  ideAutoStart();

  document.querySelectorAll('.topic').forEach((topic)=>topic.addEventListener('click',()=>{document.querySelectorAll('.topic').forEach((item)=>item.classList.remove('selected'));topic.classList.add('selected');}));
  const form=document.querySelector<HTMLFormElement>('[data-contact-form]');const success=document.querySelector<HTMLElement>('[data-success]');form?.addEventListener('submit',(event)=>{event.preventDefault();form.classList.add('is-hidden');success?.classList.add('is-visible');});document.querySelector('[data-reset-form]')?.addEventListener('click',()=>{form?.reset();form?.classList.remove('is-hidden');success?.classList.remove('is-visible');});
  document.querySelector('[data-theme-toggle]')?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;localStorage.setItem('monfolio-theme',next);});
  const cardStack=document.querySelector<HTMLElement>('.card-stack');cardStack?.addEventListener('click',()=>cardStack.classList.toggle('is-swapped'));cardStack?.addEventListener('keydown',(e)=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();cardStack.classList.toggle('is-swapped');}});

  // Dynamic Projects Grid Filtering & Max Cards Display
  const projectCards = Array.from(document.querySelectorAll<HTMLElement>('.project-grid .project-card'));
  const filterTabs = document.querySelectorAll<HTMLElement>('.filter-tab');
  const toggleBtn = document.querySelector<HTMLElement>('[data-toggle-projects]');
  const counterEl = document.querySelector<HTMLElement>('[data-project-counter]');
  const maxDefault = 4;
  let currentFilter = 'all';
  let isExpanded = false;

  function updateProjectGrid(animate = false) {
    const matching = projectCards.filter(card => {
      if (currentFilter === 'all') return true;
      return card.dataset.category === currentFilter;
    });

    projectCards.forEach(card => card.classList.add('is-hidden'));

    const visible = isExpanded ? matching : matching.slice(0, maxDefault);
    visible.forEach(card => card.classList.remove('is-hidden'));

    if (counterEl) {
      counterEl.textContent = `Showing ${visible.length} of ${matching.length} ${matching.length === 1 ? 'build' : 'builds'}`;
    }

    if (toggleBtn) {
      if (matching.length <= maxDefault) {
        toggleBtn.style.display = 'none';
      } else {
        toggleBtn.style.display = 'inline-flex';
        const label = isExpanded ? 'Show fewer ↑' : `Show all ${matching.length} projects ↓`;
        toggleBtn.querySelectorAll('span').forEach(s => s.textContent = label);
      }
    }

    if (animate && visible.length > 0) {
      gsap.fromTo(visible, { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.35, stagger: 0.04, ease: 'power2.out' });
    }

    ScrollTrigger.refresh();
  }

  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-pressed', 'false'); });
      tab.classList.add('is-active');
      tab.setAttribute('aria-pressed', 'true');
      currentFilter = tab.dataset.filter || 'all';
      isExpanded = false;
      updateProjectGrid(true);
    });
  });

  toggleBtn?.addEventListener('click', () => {
    isExpanded = !isExpanded;
    updateProjectGrid(true);
  });

  updateProjectGrid(false);
</script>
