---
import SiteShell from '../layouts/SiteShell.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import SectionMarker from '../components/SectionMarker.astro';
import FaqSection from '../components/FaqSection.astro';
import TestimonialSection from '../components/TestimonialSection.astro';
import HeroGridAnimation from '../components/HeroGridAnimation.astro';
import {
  getAnnouncement,
  getFaqs,
  getHomePage,
  getNavigation,
  getProjects,
  getServices,
  getSiteSettings,
  getTestimonials,
} from '@monfolio/content';

const [projects, services, testimonials, faqs, home, navigation, settings, announcement] =
  await Promise.all([
    getProjects(),
    getServices(),
    getTestimonials(),
    getFaqs(),
    getHomePage(),
    getNavigation(),
    getSiteSettings(),
    getAnnouncement(),
  ]);

const featuredProject =
  home.work.featured.project ?? projects.find((project) => project.featured) ?? projects[0];

const filterCounts = Object.fromEntries(
  home.work.filters.map((filter) => [
    filter.key,
    filter.key === 'all'
      ? projects.length
      : projects.filter((project) => project.categoryKey === filter.key).length,
  ]),
);

const visibleProjectCount = Math.min(projects.length, home.work.maxVisible);
const slideTotal = String(home.hero.carousel.length).padStart(2, '0');
---
<SiteShell settings={settings} navigation={navigation} announcement={announcement}>
    <main>
      <section class="hero-stage bg-surface px-5 sm:px-8 lg:px-8">
        <HeroGridAnimation />
        <div class="hero-wrap relative z-10 mx-auto flex min-h-[calc(100svh-7.5rem)] max-w-7xl flex-col pt-4 sm:pt-5 lg:h-[calc(100svh-7.5rem)]">
          <div class="hero-grid-row my-auto grid gap-8 pb-28 lg:grid-cols-[7fr_3fr] lg:gap-14">
            <div class="hero-left flex flex-col items-start gap-12">
              <span class="studio-badge"><i></i> {home.hero.badge}</span>
              <h1 class="hero-title mt-4 max-w-5xl font-display text-[clamp(2.6rem,4.8vw,5rem)] font-semibold leading-[1.02] tracking-[-.06em]" set:html={home.hero.heading} />
              <div class="hero-skills flex flex-wrap gap-2">
                {home.hero.skills.map((skill) => (
                  <span class="skill-chip"><em>✦</em> {skill}</span>
                ))}
              </div>
              <p class="hero-desc max-w-md text-[15px] leading-[1.7] text-muted">{home.hero.description}</p>
              <div class="hero-cta flex flex-wrap gap-3">
                <a class="button button-orange rolling-button" href={home.hero.primaryCta.href}><span>{home.hero.primaryCta.label}</span><span aria-hidden="true">{home.hero.primaryCta.label}</span></a>
                <a class="button button-outline rolling-button" href={home.hero.secondaryCta.href}><span>{home.hero.secondaryCta.label}</span><span aria-hidden="true">{home.hero.secondaryCta.label}</span></a>
              </div>
              <div class="availability pt-2"><i></i> {home.hero.availability} <span>· {home.hero.availabilityNote}</span></div>
            </div>
            <div class="hero-right flex flex-col items-start gap-6">
              <span class="location-badge">{home.hero.locationBadge}</span>
              <div class="ide-stack w-full">
              <div class="ide-carousel" aria-hidden="true">
                {home.hero.carousel.map((slide, index) => (
                  <figure class="ide-card" data-ide-card>
                    <img src={slide.image} alt="" loading="lazy" decoding="async" />
                    <figcaption><b>{slide.caption}</b><span>{String(index + 1).padStart(2, '0')} / {slideTotal}</span></figcaption>
                  </figure>
                ))}
              </div>
              <div class="ide-dots" aria-hidden="true"></div>
              <div class="ide-window" aria-hidden="true">
                <div class="ide-chrome"><span class="ide-dot"></span><span class="ide-dot"></span><span class="ide-dot"></span><span class="ide-tab">designer.config</span></div>
                <div class="ide-body">
                  <pre class="ide-code"><code id="ide-code"><span class="ide-caret"></span></code></pre>
                  <div class="ide-results is-hidden">
                    <figure class="ide-result">
                      <div class="mock-screen mock-dash">
                        <i class="mock-el mock-title"></i>
                        <div class="mock-stats"><i class="mock-el"></i><i class="mock-el"></i><i class="mock-el"></i></div>
                        <div class="mock-chart"><i class="mock-el mock-bar" style="--h:62%"></i><i class="mock-el mock-bar" style="--h:88%"></i><i class="mock-el mock-bar" style="--h:45%"></i><i class="mock-el mock-bar" style="--h:74%"></i><i class="mock-el mock-bar" style="--h:56%"></i></div>
                      </div>
                      <figcaption>Dashboard</figcaption>
                    </figure>
                    <figure class="ide-result">
                      <div class="mock-screen mock-landing">
                        <div class="mock-nav"><i class="mock-el"></i><i class="mock-el"></i><i class="mock-el"></i></div>
                        <div class="mock-headline"><i class="mock-el"></i><i class="mock-el"></i></div>
                        <i class="mock-el mock-btn"></i>
                        <div class="mock-blocks"><i class="mock-el"></i><i class="mock-el"></i></div>
                      </div>
                      <figcaption>Minimal landing</figcaption>
                    </figure>
                    <figure class="ide-result">
                      <div class="mock-screen mock-social">
                        <div class="mock-profile"><i class="mock-el mock-avatar"></i><div class="mock-id"><i class="mock-el"></i><i class="mock-el"></i></div></div>
                        <div class="mock-lines"><i class="mock-el"></i><i class="mock-el"></i></div>
                        <div class="mock-actions"><i class="mock-el"></i><i class="mock-el"></i><i class="mock-el"></i></div>
                      </div>
                      <figcaption>Social media</figcaption>
                    </figure>
                  </div>
                </div>
                <div class="ide-status"><span id="ide-status">ready</span><span class="ide-progress"><i id="ide-bar"></i></span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
        <div class="client-marquee mt-16 pb-10">
          <div class="marquee-track">
            {home.hero.marquee.map((name) => (
              <span><b>{name.slice(0,1)}</b>{name}</span>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="bg-surface-lift px-5 py-20 sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl" data-fade-stagger>
          <SectionMarker number={home.markers.about.number} label={home.markers.about.label} />
          <div class="intro-head">
            <h2 class="display-heading" set:html={home.about.heading} />
            <p>{home.about.intro}</p>
          </div>
          <div class="intro-tiles">
            {home.about.tiles.map((tile) => (
              <div class={`intro-tile ${tile.variant === 'dark' ? 'tile-system' : 'tile-studio'}`}>
                {tile.variant === 'dark' ? <div class="system-lines"></div> : <div class="tile-orbit"></div>}
                <div class={`caption-card${tile.variant === 'dark' ? ' dark' : ''}`}><span>{tile.label}</span><small>{tile.caption}</small></div>
              </div>
            ))}
          </div>
          <div class="pillars">
            {home.about.pillars.map((pillar) => (
              <article class="pillar-card">
                <span>{pillar.label}</span>
                <h3>{pillar.title}</h3>
                <p>{pillar.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="work" class="bg-surface px-5 py-20 sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl">
          <div class="section-head" data-fade-stagger>
            <SectionMarker number={home.markers.work.number} label={home.markers.work.label} />
            <div class="head-row">
              <h2 class="display-heading" set:html={home.work.heading} />
              <p>{home.work.intro}</p>
            </div>
          </div>
          <article class="featured-build" data-fade-stagger>
            <div class="featured-copy">
              <span class="orange-badge">{home.work.featured.badge}</span>
              <small>{home.work.featured.category}</small>
              <h3>{home.work.featured.title}</h3>
              <p>{home.work.featured.description}</p>
              <div>
                <a class="white-chip" href={home.work.featured.cta.href}>{home.work.featured.cta.label}</a>
                <span class="read-time">{home.work.featured.readTime}</span>
              </div>
            </div>
            <div class="featured-visual">
              <div class="card-stack" role="button" aria-label="Toggle project cards" tabindex="0">
                <div class="card-back" aria-hidden="true">
                  {home.work.featured.backImage && <img src={home.work.featured.backImage} alt="" loading="lazy" decoding="async" />}
                  <span class="card-back-badge">{home.work.featured.backBadge}</span>
                </div>
                <div class="card-front"><ProjectVisual image={featuredProject?.image ?? ''} imageAlt={featuredProject?.imageAlt ?? ''} /></div>
              </div>
            </div>
          </article>
          <div class="projects-toolbar mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between" data-fade-stagger>
            <div class="project-filters flex flex-wrap gap-2" role="group" aria-label="Filter projects">
              {home.work.filters.map((filter, index) => (
                <button
                  type="button"
                  class={`filter-tab${index === 0 ? ' is-active' : ''}`}
                  data-filter={filter.key}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >{filter.label} <span class="filter-count">({filterCounts[filter.key] ?? 0})</span></button>
              ))}
            </div>
            <span class="project-counter text-xs font-semibold text-muted" data-project-counter>Showing {visibleProjectCount} of {projects.length} featured builds</span>
          </div>
          <div class="project-grid" data-max={home.work.maxVisible}>
            {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
          </div>
          <div class="projects-actions mt-12 flex justify-center">
            <button
              type="button"
              class="button button-outline rolling-button"
              data-toggle-projects
              data-show-all={home.work.showAllLabel}
              data-show-less={home.work.showLessLabel}
            >
              <span>{home.work.showAllLabel} {projects.length} projects ↓</span>
              <span aria-hidden="true">{home.work.showAllLabel} {projects.length} projects ↓</span>
            </button>
          </div>
        </div>
      </section>

      <FaqSection faqs={faqs} marker={home.markers.faq} copy={home.faq} />

      <section id="story" class="story-section bg-ink px-5 py-20 text-surface sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl" data-fade-stagger>
          <SectionMarker number={home.markers.story.number} label={home.markers.story.label} />
          <div class="story-head">
            <h2 class="story-title" set:html={home.story.title} />
            <p>{home.story.intro}</p>
          </div>
          <div class="story-video">
            <div class="story-art">
              <span class="story-circle"></span>
              <span class="story-spark">+</span>
              <span class="story-word" set:html={home.story.artWord} />
            </div>
            <div class="play-wrap">
              <span class="play-ring"></span>
              <button type="button" aria-label="Play studio story">▶</button>
              <span class="watch-pill">{home.story.videoLabel}</span>
            </div>
            <div class="story-bar">
              <span><i></i> {home.story.barLocation}</span>
              <small>{home.story.barNote}</small>
            </div>
          </div>
        </div>
      </section>

      <TestimonialSection testimonials={testimonials} marker={home.markers.reviews} copy={home.reviews} />

      <section id="services" class="bg-surface-lift px-5 py-20 sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl" data-fade-stagger>
          <SectionMarker number={home.markers.services.number} label={home.markers.services.label} />
          <div class="head-row services-head">
            <h2 class="display-heading" set:html={home.services.heading} />
            <p>{home.services.intro}</p>
          </div>
          <div class="service-cells">
            {services.map((service) => (
              <article class="service-cell" data-service-cell>
                <div class="flex items-start justify-between">
                  <span class="text-sm font-bold text-orange">{service.number}</span>
                  <span class="service-plus">↗</span>
                </div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <ul>{service.items.map((item) => <li>{item}</li>)}</ul>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="contact-section bg-surface px-5 py-20 sm:px-8 sm:py-28 lg:px-8">
        <div class="mx-auto max-w-7xl" data-fade-stagger>
          <SectionMarker number={home.markers.contact.number} label={home.markers.contact.label} />
          <h2 class="contact-title" set:html={home.contact.title} />
          <div class="avatar-card">
            <div>
              <span class="eyebrow-label">{home.contact.eyebrow}</span>
              <h3>{home.contact.heading}</h3>
            </div>
            <div class="avatar-stack">
              {home.contact.avatars.map((avatar) => (
                <span title={avatar.name}>{avatar.initials}</span>
              ))}
            </div>
          </div>
          <div class="contact-bento">
            <div class="contact-form-wrap">
              <div class="success-card" data-success>
                <strong>✓</strong>
                <h3>{home.contact.form.successHeading}</h3>
                <p>{home.contact.form.successBody}</p>
                <button type="button" data-reset-form>{home.contact.form.resetLabel}</button>
              </div>
              <form class="contact-form" data-contact-form>
                <fieldset class="topic-group">
                  <legend>How can we help?</legend>
                  <span class="topic-row">
                    {home.contact.topics.map((topic, index) => (
                      <button type="button" class={`topic${index === 0 ? ' selected' : ''}`}>{topic}</button>
                    ))}
                  </span>
                </fieldset>
                <div class="field-row">
                  <label>Full name<input required name="name" placeholder="Your name" /></label>
                  <label>Email address<input required type="email" name="email" placeholder="you@company.com" /></label>
                </div>
                <label>Message<textarea required name="message" rows="5" placeholder="Tell us what you are building."></textarea></label>
                <div class="submit-row">
                  <button class="button button-orange" type="submit">{home.contact.form.submitLabel}</button>
                  <small>{home.contact.form.consent}</small>
                </div>
              </form>
            </div>
            <aside class="info-card">
              <div>
                <span class="eyebrow-label">{home.contact.infoCard.emailLabel}</span>
                <a href={`mailto:${settings.contactEmail}`}>{settings.contactEmail}</a>
              </div>
              <div>
                <span class="eyebrow-label">{home.contact.infoCard.studioLabel}</span>
                <p class="whitespace-pre-line">{settings.address}</p>
              </div>
              <div>
                <span class="eyebrow-label">{home.contact.infoCard.howWeWorkLabel}</span>
                <ul>
                  {home.contact.infoCard.howWeWorkItems.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            </aside>
          </div>
        </div>
      </section>
    </main>
</SiteShell>

<style>
  .section-marker{display:flex;align-items:center;gap:.65rem;margin-bottom:2rem;color:var(--color-muted);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
  .section-marker>span{display:grid;width:1.5rem;height:1.5rem;place-items:center;border-radius:50%;background:var(--color-ink);color:var(--color-surface);font-size:10px;letter-spacing:0}
  .section-marker b{font-weight:700}
  .hero-stage{position:relative;overflow:hidden}
  .hero-grid{position:absolute;inset:0;background-image:linear-gradient(var(--color-line) 1px,transparent 1px),linear-gradient(90deg,var(--color-line) 1px,transparent 1px);background-size:6rem 6rem;opacity:.24;mask-image:linear-gradient(to bottom,black,transparent 75%)}
  .hero-meta{display:flex;justify-content:space-between;gap:1rem}
  .studio-badge,.location-badge{display:inline-flex;align-items:center;gap:.55rem;border:1px solid var(--color-line);border-radius:999px;padding:.55rem .8rem;color:var(--color-ink);font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .studio-badge i,.availability i{width:.45rem;height:.45rem;border-radius:50%;background:#16a36a;box-shadow:0 0 0 .2rem color-mix(in srgb,#16a36a 18%,transparent)}
  .location-badge{border-color:var(--color-ink);background:var(--color-ink);color:var(--color-surface)}
  .client-chip,.showreel-chip{display:inline-flex;align-items:center;gap:.5rem;border:1px solid var(--color-line);border-radius:999px;padding:.3rem .8rem .35rem;font-size:.25em;font-weight:600;letter-spacing:-.04em;vertical-align:middle}
  .client-chip{background:var(--color-ink);color:var(--color-surface)}
  .client-chip i{font-size:.7em;font-style:normal;color:var(--color-accent)}
  .showreel-chip{border-color:var(--color-accent);background:var(--color-accent);color:#070d14}
  .showreel-chip b{display:grid;width:1.8em;height:1.8em;place-items:center;border-radius:50%;background:var(--color-surface);font-size:.45em}
  .availability{display:flex;align-items:center;gap:.6rem;color:var(--color-ink);font-size:11px;font-weight:700}
  .availability span{color:var(--color-muted);font-weight:500}
  .skill-chip{display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--color-line);border-radius:999px;padding:.4rem .75rem;font-size:10px;font-weight:700;background:var(--color-surface);color:var(--color-ink)}
  .skill-chip em{color:var(--color-accent);font-style:normal}
  .ide-stack{display:flex;flex-direction:column;gap:1.5rem;width:100%}
  .ide-dots{display:none}
  .ide-carousel{position:relative;width:100%;aspect-ratio:16/10;height:auto;perspective:1000px;flex:none}
  /* Per-device sizing: kompresi judul di layar pendek agar hero muat 1 layar */
  @media (min-width:1024px) and (max-height:820px){
    .hero-stage .hero-title{font-size:clamp(1.9rem,3.2vw,2.8rem)}
    .ide-carousel{aspect-ratio:2/1}
    .ide-stack{gap:1rem}
  }
  /* Jaminan muat: availability selalu terlihat */
  @media (min-width:1024px){
    .hero-grid-row{min-height:0}
  }
  .ide-card{position:absolute;top:50%;height:auto;width:40%;aspect-ratio:4/5;margin:0;overflow:hidden;border-radius:1rem;border:1px solid rgba(255,255,255,.12);background:#0b1118;box-shadow:0 20px 40px -12px rgba(7,13,20,.4);transition:transform .8s cubic-bezier(.22,1,.36,1),opacity .8s cubic-bezier(.22,1,.36,1),left .8s cubic-bezier(.22,1,.36,1),filter .8s cubic-bezier(.22,1,.36,1);cursor:pointer;will-change:transform,left,opacity}
  .ide-card img{display:block;width:100%;height:100%;object-fit:cover}
  .ide-card figcaption{position:absolute;left:.7rem;right:.7rem;bottom:.6rem;display:flex;align-items:center;justify-content:space-between;border-radius:999px;background:rgba(11,17,24,.82);backdrop-filter:blur(8px);padding:.35rem .65rem;color:#fff}
  .ide-card figcaption b{font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .ide-card figcaption span{color:rgba(255,255,255,.55);font-size:9px;font-weight:700}
  .ide-card[data-pos="center"]{left:25%;width:50%;transform:translateY(calc(-50% - 6px));opacity:1;z-index:10;box-shadow:0 25px 50px -12px rgba(7,13,20,.9),0 0 0 1px rgba(255,255,255,.25),0 0 30px color-mix(in srgb,var(--color-accent) 25%,transparent)}
  .ide-card[data-pos="center"]:hover{transform:translateY(calc(-50% - 10px)) scale(1.03)}
  .ide-card[data-pos="left"]{left:8%;width:40%;transform:translateY(calc(-50% + 6px)) scale(.9);opacity:.55;z-index:5;filter:brightness(.65)}
  .ide-card[data-pos="right"]{left:52%;width:40%;transform:translateY(calc(-50% + 6px)) scale(.9);opacity:.55;z-index:5;filter:brightness(.65)}
  .ide-card[data-pos="hidden"]{left:25%;transform:translateY(-50%) scale(.7);opacity:0;z-index:1;pointer-events:none}
  .ide-window{display:flex;flex-direction:column;width:100%;aspect-ratio:16/9;height:auto;overflow:hidden;border-radius:1rem;border:1px solid color-mix(in srgb,#ffffff 14%,transparent);background:#0b1118;box-shadow:0 24px 48px -12px rgba(7,13,20,.35);font-family:ui-monospace,'SF Mono',Menlo,Consolas,monospace}
  .ide-chrome{display:flex;align-items:center;gap:.45rem;padding:.7rem .9rem;border-bottom:1px solid rgba(255,255,255,.08)}
  .ide-dot{width:.6rem;height:.6rem;border-radius:50%;background:rgba(255,255,255,.18)}
  .ide-dot:nth-child(1){background:#f15533}
  .ide-dot:nth-child(2){background:#e8b93c}
  .ide-dot:nth-child(3){background:#16a36a}
  .ide-tab{margin-left:.6rem;color:rgba(255,255,255,.55);font-size:10px;letter-spacing:.08em}
  .ide-code{display:block;height:100%;margin:0;padding:.9rem 1.1rem;font-size:11px;line-height:1.6;color:#dfe4ea;white-space:pre-wrap}
  .ide-body{position:relative;flex:1;min-height:0}
  .ide-results{position:absolute;inset:0}
  .ide-results.is-hidden{display:none}
  .ide-result{position:absolute;inset:1rem 1.1rem;margin:0;display:flex;flex-direction:column;opacity:0;visibility:hidden}
  .mock-screen{display:flex;flex-direction:column;gap:.45rem;flex:1;min-height:0;border-radius:.5rem;border:1px solid rgba(255,255,255,.1);background:linear-gradient(160deg,#101a24,#0b1118);padding:.55rem;overflow:hidden}
  .mock-el{display:block;background:rgba(255,255,255,.16);border-radius:2px}
  .mock-title{width:55%;height:5px;background:var(--color-accent)}
  .mock-stats{display:flex;gap:.35rem}
  .mock-stats .mock-el{flex:1;height:.75rem;border-radius:3px}
  .mock-chart{display:flex;align-items:flex-end;gap:4px;flex:1;min-height:0}
  .mock-bar{flex:1;height:var(--h,50%);background:var(--color-accent);opacity:.85;transform-origin:bottom}
  .mock-nav{display:flex;gap:4px}
  .mock-nav .mock-el{width:.6rem;height:4px}
  .mock-headline .mock-el{height:6px;margin-bottom:4px}
  .mock-headline .mock-el:first-child{width:80%}
  .mock-headline .mock-el:last-child{width:55%}
  .mock-btn{width:2rem;height:.6rem;border-radius:999px;background:var(--color-accent)}
  .mock-blocks{display:flex;gap:4px;flex:1;min-height:0}
  .mock-blocks .mock-el{flex:1;border-radius:3px}
  .mock-profile{display:flex;align-items:center;gap:.35rem}
  .mock-avatar{width:.85rem;height:.85rem;border-radius:50%;background:var(--color-accent);flex:none}
  .mock-id{flex:1}
  .mock-id .mock-el{height:4px;margin-bottom:3px}
  .mock-id .mock-el:first-child{width:60%}
  .mock-id .mock-el:last-child{width:40%;margin-bottom:0}
  .mock-lines .mock-el{height:4px;margin-bottom:4px}
