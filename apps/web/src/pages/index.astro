  .card-back-badge{position:absolute;top:.85rem;right:.85rem;border-radius:999px;background:color-mix(in srgb,var(--color-ink) 85%,transparent);backdrop-filter:blur(8px);color:var(--color-surface);font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;padding:.32rem .65rem;border:1px solid color-mix(in srgb,var(--color-surface) 22%,transparent)}
  .card-front{position:relative;z-index:2;border-radius:1rem;border:1px solid color-mix(in srgb,var(--color-surface) 14%,transparent);box-shadow:0 22px 44px -8px rgba(0,0,0,.55)}
